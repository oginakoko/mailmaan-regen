# Mailmaan — copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (project ref bgbtxtbjgybhzufoyvjn, "mailmaan")
NEXT_PUBLIC_SUPABASE_URL=https://bgbtxtbjgybhzufoyvjn.supabase.co
# Publishable key (safe in browser code; RLS still applies)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only service-role key (never expose to the browser). Required from Day 2 onward.
SUPABASE_SERVICE_ROLE_KEY=
# Base URL of this app (used for absolute links/emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Later milestones (leave empty until configured) ---
# Resend (Day 4): RESEND_API_KEY=
# Resend webhooks (Day 5): RESEND_WEBHOOK_SECRET=
# Inngest (Day 4): INNGEST_EVENT_KEY=, INNGEST_SIGNING_KEY=

# AI template generation (Day 3): Meta Muse via the Meta Model API
# (https://api.meta.ai/v1, OpenAI-compatible). Server-only, never commit a
# real key. Without BOTH a key and a model id, generation uses deterministic
# templates labelled as fallback/demo (Blueprint §10).
AI_API_KEY=
AI_BASE_URL=https://api.meta.ai/v1
# Cheap/lightweight Muse model id, e.g. a mini/lite Spark variant:
AI_TEMPLATE_MODEL=
AI_MODELS_PATH=/chat/completions
